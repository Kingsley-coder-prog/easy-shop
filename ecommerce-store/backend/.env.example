NODE_ENV=development
PORT=5000

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_xxxx_paste_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_xxxx_paste_your_paystack_public_key_here
PAYSTACK_BASE_URL=https://api.paystack.co

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Database (Optional - if using MongoDB)
MONGODB_URI=mongodb://localhost:27017/shopeasy

# SMTP / Email (for sending order notifications)
# Example (Mailgun/SMTP): set SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, and EMAIL_FROM
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="ShopEasy <no-reply@example.com>"

# AWS SES (optional - if using SES set AWS creds and region)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
